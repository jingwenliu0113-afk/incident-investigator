# Project overrides applied after upstream .env (later --env-file wins).
# Any change here changes the experiment environment: re-run `python -m env resolve`
# and record why in docs/decisions/.

# Upstream 3.1.0 ships DEMO_VERSION=latest, so a plain `docker compose up` at the
# tag pulls the floating `latest-<service>` images. Pin the release tag instead
# (images are additionally pinned by digest in env/compose.pinned.yaml).
DEMO_VERSION=3.1.0

# Upstream 3.1.0 still says IMAGE_VERSION=3.0.0; it feeds service.version in
# OTEL_RESOURCE_ATTRIBUTES, so telemetry would mislabel the running release.
IMAGE_VERSION=3.1.0
# Upstream .env expands OTEL_RESOURCE_ATTRIBUTES while it is parsed, i.e. with
# IMAGE_VERSION=3.0.0; it must be re-declared here to pick up the override above
# (guarded by tests/test_traffic.py).
OTEL_RESOURCE_ATTRIBUTES=service.namespace=${OTEL_SERVICE_NAMESPACE},service.version=${IMAGE_VERSION}
