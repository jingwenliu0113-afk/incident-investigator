    "class_c": [
      "Payment request failed. Invalid token. demo.user_context.loyalty_level=gold",
      "badhost:1234",
      "badAddress:50051",
      "LOCK TABLE catalog.products IN ACCESS EXCLUSIVE MODE"
    ]
  },
