{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence_gold.schema.json",
  "title": "Human gold relevance judgments of cited evidence for one incident (decision 017)",
  "description": "Ground-truth side; append-only. Each item is one pooled citation (id with its optional metric time range) judged blind to the method that cited it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["gold_version", "incident_id", "items"],
  "properties": {
    "gold_version": {"const": 1},
    "incident_id": {"type": "string", "pattern": "^INC-[0-9]{3,}(?!\\n)$"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "t0", "t1", "relevant", "annotator", "annotated_at"],
        "properties": {
          "id": {"type": "string", "pattern": "^[slmpt]-[0-9a-f]{16,32}(?!\\n)$"},
          "t0": {"type": ["integer", "null"]},
          "t1": {"type": ["integer", "null"]},
          "relevant": {"type": "boolean"},
          "annotator": {"type": "string", "pattern": "^human:[^\\s].*(?!\\n)$"},
          "annotated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?!\\n)$"},
          "note": {"type": "string"}
        }
      }
    }
  }
}
