{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://incident-investigator.local/schemas/env_lock.schema.json",
  "title": "OTel Demo environment lock",
  "description": "Everything needed to bring up byte-identical OTel Demo stacks: upstream commit, startup files (with checksums), and every image pinned by digest with per-platform manifests. Generated by `python -m env resolve`; verified by `python -m env verify`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lock_version",
    "generated_at",
    "upstream",
    "startup",
    "required_platforms",
    "images",
    "bind_mounts"
  ],
  "properties": {
    "lock_version": {
      "const": 1
    },
    "generated_at": {
      "$ref": "#/$defs/utc_timestamp"
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "tag",
        "commit",
        "demo_image_repo"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^https://"
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}(?!\\n)$"
        },
        "demo_image_repo": {
          "type": "string",
          "description": "registry/repository of the demo's own service images; their tags must start with '<tag>-'"
        }
      }
    },
    "startup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_name",
        "compose_files",
        "env_files",
        "up_args"
      ],
      "properties": {
        "project_name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*(?!\\n)$"
        },
        "compose_files": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/file_ref"
          }
        },
        "env_files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file_ref"
          }
        },
        "up_args": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "required_platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/platform"
      }
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "services",
          "index_digest",
          "media_type",
          "platforms"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "services": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "index_digest": {
            "$ref": "#/$defs/digest"
          },
          "media_type": {
            "type": "string"
          },
          "platforms": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "$ref": "#/$defs/platform"
            },
            "additionalProperties": {
              "$ref": "#/$defs/digest"
            }
          }
        }
      }
    },
    "bind_mounts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "service",
          "target",
          "source",
          "kind",
          "sha256",
          "read_only"
        ],
        "properties": {
          "service": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "root",
              "path"
            ],
            "properties": {
              "root": {
                "enum": [
                  "upstream",
                  "project",
                  "host"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "kind": {
            "enum": [
              "file",
              "dir",
              "host"
            ]
          },
          "sha256": {
            "oneOf": [
              {
                "$ref": "#/$defs/digest"
              },
              {
                "type": "null"
              }
            ]
          },
          "read_only": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?!\\n)$"
    },
    "platform": {
      "type": "string",
      "pattern": "^[a-z0-9]+/[a-z0-9_]+(/[a-z0-9]+)?(?!\\n)$"
    },
    "utc_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z(?!\\n)$"
    },
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "path",
        "sha256"
      ],
      "properties": {
        "root": {
          "enum": [
            "upstream",
            "project"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/]"
        },
        "sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "generated": {
          "type": "boolean"
        }
      }
    }
  }
}
