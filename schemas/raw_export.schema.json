{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://incident-investigator.local/schemas/raw_export.schema.json",
  "title": "Raw telemetry export of one run group (NOT agent-readable)",
  "description": "Stored at data/external/raw/<run_group_id>/raw_export.json next to the three OTLP JSON Lines files (decision 008). Built by collect.rawexport.build_raw_export from collect.rawfile scans; complete is true only when there are no flags.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "raw_export_version",
    "run_group_id",
    "env_lock_sha256",
    "collector",
    "files",
    "flags",
    "complete"
  ],
  "properties": {
    "raw_export_version": {
      "const": 1
    },
    "run_group_id": {
      "type": "string",
      "pattern": "^RG-[0-9]{3,}(?!\\n)$"
    },
    "env_lock_sha256": {
      "$ref": "#/$defs/digest"
    },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "container_id",
        "restarts",
        "stop_exit_code",
        "stop_seconds",
        "cp_seconds",
        "copied"
      ],
      "properties": {
        "container_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "restarts": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "stop_exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "graceful_stop": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "exit 0, or exit 1 with the shutdown-log verdict (decision 008 revision)"
        },
        "shutdown_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "stop_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cp_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "copied": {
          "type": "boolean"
        }
      }
    },
    "files": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "signal",
          "format",
          "bytes",
          "sha256",
          "lines",
          "empty_lines",
          "empty_messages",
          "parse_errors",
          "parse_error_lines",
          "last_line_truncated",
          "wrong_signal_lines",
          "items",
          "duplicates",
          "min_time",
          "max_time",
          "by_service",
          "minutes"
        ],
        "properties": {
          "path": {
            "enum": [
              "traces.jsonl",
              "metrics.jsonl",
              "logs.jsonl"
            ]
          },
          "signal": {
            "enum": [
              "traces",
              "metrics",
              "logs"
            ]
          },
          "format": {
            "const": "otlp-json-lines"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "$ref": "#/$defs/digest"
          },
          "lines": {
            "type": "integer",
            "minimum": 0
          },
          "empty_lines": {
            "type": "integer",
            "minimum": 0
          },
          "empty_messages": {
            "type": "integer",
            "minimum": 0,
            "description": "lines that are an empty export message ({}): valid, no data (decision 008 revision 3)"
          },
          "parse_errors": {
            "type": "integer",
            "minimum": 0
          },
          "parse_error_lines": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "last_line_truncated": {
            "type": "boolean"
          },
          "wrong_signal_lines": {
            "type": "integer",
            "minimum": 0
          },
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "duplicates": {
            "type": "integer",
            "minimum": 0
          },
          "min_time": {
            "oneOf": [
              {
                "$ref": "#/$defs/utc_timestamp"
              },
              {
                "type": "null"
              }
            ]
          },
          "max_time": {
            "oneOf": [
              {
                "$ref": "#/$defs/utc_timestamp"
              },
              {
                "type": "null"
              }
            ]
          },
          "by_service": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "minutes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(?!\\n)$"
            }
          }
        }
      }
    },
    "flags": {
      "description": "Why the export is incomplete (decision 008 §6); empty when complete.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(collector_restarted|collector_sigkilled|collector_unclean_stop|copy_failed|memory_limiter_refused|exporter_rejected|accounting_unavailable|accounting_mismatch:(traces|metrics|logs)|missing_file:(traces|metrics|logs)|parse_errors:(traces|metrics|logs))(?!\\n)$"
      }
    },
    "complete": {
      "type": "boolean"
    },
    "accounting": {
      "description": "Loss accounting (decision 008 §6, shape fixed on soak #3 counters): deltas over the incident window between the collector exports that bracket it; SDK errors are reported, not flagged.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accounting_version",
        "window_ns",
        "snapshots",
        "signals",
        "sdk_errors",
        "flags"
      ],
      "properties": {
        "accounting_version": {
          "const": 1
        },
        "window_ns": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "snapshots": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "base",
            "final"
          ],
          "properties": {
            "base": {
              "type": [
                "integer",
                "null"
              ]
            },
            "final": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        "signals": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "traces": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "accepted",
                "refused",
                "failed",
                "sent",
                "send_failed",
                "memory_limiter_dropped",
                "file_items",
                "final_sent"
              ],
              "properties": {
                "accepted": {
                  "type": "integer",
                  "minimum": 0
                },
                "refused": {
                  "type": "integer",
                  "minimum": 0
                },
                "failed": {
                  "type": "integer",
                  "minimum": 0
                },
                "sent": {
                  "type": "integer",
                  "minimum": 0
                },
                "send_failed": {
                  "type": "integer",
                  "minimum": 0
                },
                "memory_limiter_dropped": {
                  "type": "integer",
                  "minimum": 0
                },
                "file_items": {
                  "type": "integer",
                  "minimum": 0
                },
                "final_sent": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "metrics": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "accepted",
                "refused",
                "failed",
                "sent",
                "send_failed",
                "memory_limiter_dropped",
                "file_items",
                "final_sent"
              ],
              "properties": {
                "accepted": {
                  "type": "integer",
                  "minimum": 0
                },
                "refused": {
                  "type": "integer",
                  "minimum": 0
                },
                "failed": {
                  "type": "integer",
                  "minimum": 0
                },
                "sent": {
                  "type": "integer",
                  "minimum": 0
                },
                "send_failed": {
                  "type": "integer",
                  "minimum": 0
                },
                "memory_limiter_dropped": {
                  "type": "integer",
                  "minimum": 0
                },
                "file_items": {
                  "type": "integer",
                  "minimum": 0
                },
                "final_sent": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "logs": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "accepted",
                "refused",
                "failed",
                "sent",
                "send_failed",
                "memory_limiter_dropped",
                "file_items",
                "final_sent"
              ],
              "properties": {
                "accepted": {
                  "type": "integer",
                  "minimum": 0
                },
                "refused": {
                  "type": "integer",
                  "minimum": 0
                },
                "failed": {
                  "type": "integer",
                  "minimum": 0
                },
                "sent": {
                  "type": "integer",
                  "minimum": 0
                },
                "send_failed": {
                  "type": "integer",
                  "minimum": 0
                },
                "memory_limiter_dropped": {
                  "type": "integer",
                  "minimum": 0
                },
                "file_items": {
                  "type": "integer",
                  "minimum": 0
                },
                "final_sent": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        "sdk_errors": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?!\\n)$"
    },
    "utc_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z(?!\\n)$"
    }
  }
}
